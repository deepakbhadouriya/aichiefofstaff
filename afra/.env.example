AFRA_ENV=development
AFRA_APP_NAME=A-FRA API
AFRA_API_HOST=0.0.0.0
AFRA_API_PORT=8000
AFRA_DASHBOARD_PORT=3000
AFRA_DATABASE_URL=postgresql+psycopg://afra:afra@db:5432/afra
AFRA_REDIS_URL=redis://redis:6379/0
AFRA_OPENAI_MODEL=gpt-4.1-mini
AFRA_LOG_LEVEL=INFO
AFRA_DEFAULT_TENANT=demo-tenant
AFRA_DEFAULT_PROFILE_ID=demo_user
AFRA_REALTIME_SYNC_INTERVAL_SECONDS=30
AFRA_RUNTIME_STORE_PATH=.runtime/runtime_store.json
